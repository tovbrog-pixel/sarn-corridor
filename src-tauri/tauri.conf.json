{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "France 1944",
  "version": "0.1.0",
  "identifier": "com.danelbd.france1944",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "France 1944",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tov Binyamin Brog",
    "copyright": "Copyright 2026 Tov Binyamin Brog",
    "shortDescription": "France 1944-45 campaign game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
